{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "songtie",
  "version": "0.1.0",
  "identifier": "com.songtie.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "松贴",
        "url": "index.html",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "quick-capture",
        "title": "随手贴",
        "url": "index.html?window=quick-capture",
        "visible": false,
        "width": 560,
        "height": 300,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/songtie.desktop.hbs"
      }
    }
  }
}
